<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="快捷面板 · 内测版" Width="700" Height="530" WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True" Foreground="#F4F5F7" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStyle="None" ResizeMode="NoResize">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#22262C"/><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="CaretBrush" Value="#55D6BE"/><Setter Property="BorderBrush" Value="#414751"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="15"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#55D6BE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#22262C"/><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="Background" Value="#262C33"/><Setter Property="BorderBrush" Value="#414751"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#55D6BE"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#55D6BE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#213638"/><Setter TargetName="row" Property="BorderBrush" Value="#55D6BE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#283238"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TabButton" TargetType="Button"><Setter Property="Foreground" Value="#A9AFBA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#55D6BE"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#55D6BE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#454C54" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#181A1E" CornerRadius="12" BorderBrush="#414751" BorderThickness="1" Padding="16,10,16,12" Margin="8"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
 <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="TitleBar"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SettingsButton" Content="设置" Padding="9,3"/><Button Visibility="Collapsed" x:Name="HideButton" Content="—" Padding="9,3"/><Button x:Name="ExitButton" Content="×" ToolTip="关闭到托盘；右键托盘可退出" Padding="9,3"/></StackPanel><TextBlock Text="快捷面板" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  /  PREVIEW 0.2" Foreground="#A9AFBA" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  <TextBox x:Name="Search" Grid.Row="1" FontSize="20" Height="52" VerticalContentAlignment="Center" ToolTip="搜索应用 · f 文件 · tr 翻译 · > 命令"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TabButton}" x:Name="AllButton" Content="全部" Padding="12,4"/><Button Style="{StaticResource TabButton}" x:Name="FileButton" Content="文件" Padding="12,4"/><Button Style="{StaticResource TabButton}" x:Name="CaptureButton" Content="截图" Padding="12,4"/><Button Style="{StaticResource TabButton}" x:Name="TranslateButton" Content="翻译" Padding="12,4"/><Button Style="{StaticResource TabButton}" x:Name="TerminalButton" Content="终端" Padding="12,4"/></StackPanel>
  <Grid Grid.Row="3">
   <ListBox x:Name="Results" Background="Transparent" Foreground="#F4F5F7" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="28" Height="28" HorizontalAlignment="Left"><Image Source="{Binding Icon}"/><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#55D6BE" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#A9AFBA" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11" Foreground="#A9AFBA" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <StackPanel x:Name="TranslatePane" Visibility="Collapsed"><TextBlock Text="翻译为" Foreground="#A9AFBA" Margin="0,8"/><StackPanel Orientation="Horizontal"><Button x:Name="ChineseButton" Content="简体中文 ✓"/><Button x:Name="EnglishButton" Content="英语"/><Button x:Name="SubmitTranslation" Content="翻译  Ctrl+Enter"/></StackPanel><TextBox x:Name="Translation" Margin="0,16,0,12" Height="145" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/><Button x:Name="CopyTranslation" Content="复制译文" HorizontalAlignment="Right"/><TextBlock Text="仅提交时将文字发送至设置中的服务；API Key 保存在本机。" Foreground="#A9AFBA" FontSize="11" Margin="0,14,0,0"/></StackPanel>
   <StackPanel x:Name="TerminalPane" Visibility="Collapsed"><TextBlock Text="执行环境  /  Windows PowerShell" Foreground="#55D6BE" Margin="0,14"/><TextBlock Text="工作目录" Foreground="#A9AFBA" Margin="0,0,0,8"/><TextBox x:Name="WorkingDirectory"/><TextBlock Text="命令将在独立终端运行，输出保留在终端窗口。" Foreground="#A9AFBA" Margin="0,16"/><StackPanel Orientation="Horizontal"><Button x:Name="RunCommand" Content="在终端中运行" Background="#21554F"/><Button x:Name="SaveCommand" Content="收藏命令"/></StackPanel></StackPanel>
  </Grid>
  <StackPanel Grid.Row="4"><TextBlock x:Name="Status" Foreground="#A9AFBA" TextWrapping="Wrap" Margin="0,12,0,10"/><Border BorderBrush="#30343B" BorderThickness="0,1,0,0" Padding="0,10,0,0"><TextBlock Text="↑↓ 选择     Enter 打开     Tab 操作     Esc 返回                  Alt+Space 唤起" Foreground="#A9AFBA" FontSize="11"/></Border></StackPanel>
 </Grid></Border>
</Window>
